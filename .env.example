# MCP service identity and transport
MCP_SERVER_NAME=example-server
MCP_SERVER_VERSION=0.1.0
MCP_SERVER_INSTRUCTIONS=A modular example Model Context Protocol server.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
MCP_MAX_REQUEST_BODY_SIZE=4194304
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=console

# Streamable HTTP request protection. Use exact deployment hostnames/origins.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000,[::1]:8000
MCP_ALLOWED_ORIGINS=

# OAuth 2.1 resource-server integration (required for non-loopback HTTP binds).
# Uses the identity provider's RFC 7662 token introspection endpoint.
MCP_AUTH_ENABLED=false
# MCP_AUTH_ISSUER_URL=https://identity.example.com/
# MCP_AUTH_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_AUTH_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# MCP_AUTH_CLIENT_ID=mcp-resource-server
# MCP_AUTH_CLIENT_SECRET=load-from-secret-manager
# MCP_AUTH_REQUIRED_SCOPES=mcp:read,mcp:write
MCP_AUTH_TIMEOUT_SECONDS=3
